    {
      "source": "/vastu/assets/(.*)",
      "destination": "/vastu/assets/$1"
    },
    {
      "source": "/vastu",
      "destination": "/vastu/index.html"
    },
    {
      "source": "/vastu/",
      "destination": "/vastu/index.html"
    }
  ]
}