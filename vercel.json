{
  "redirects": [
    {
      "source": "/checkout",
      "destination": "/vastucheckout",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/astroyogi",
      "destination": "/astroyogi/index.html"
    },
    {
      "source": "/astroyogi/assets/(.*)",
      "destination": "/astroyogi/assets/$1"
    },
    {
      "source": "/vastu/admin",
      "destination": "/vastu/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/vastu/admin/index.html"
    },
    {
      "source": "/vastu",
      "destination": "/vastu/index.html"
    },
    {
      "source": "/vastu/assets/(.*)",
      "destination": "/vastu/assets/$1"
    }
  ]
}