{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "infinitytech-six.vercel.app"
        }
      ],
      "destination": "https://palmq.shop/$1",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "/vastucheckout",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/face-landmarker.worker.v2.js",
      "destination": "/face-landmarker.worker.v2.js"
    },
    {
      "source": "/api/palm/detect",
      "destination": "/api/palm/detect.js"
    },
    {
      "source": "/api/flow/refresh",
      "destination": "/api/flow/refresh.js"
    },
    {
      "source": "/api/track",
      "destination": "/api/track.js"
    },
    {
      "source": "/api/age-check",
      "destination": "/api/age-check.js"
    },
    {
      "source": "/api/reading",
      "destination": "/api/reading.js"
    },
    {
      "source": "/api/reading/(.*)",
      "destination": "/api/reading.js"
    },
    {
      "source": "/api/readings/(.*)",
      "destination": "/api/reading.js"
    },
    {
      "source": "/api/places",
      "destination": "/api/places.js"
    },
    {
      "source": "/api/lead",
      "destination": "/api/capture-lead.js"
    },
    {
      "source": "/astroyogi/assets/(.*)",
      "destination": "/astroyogi/assets/$1"
    },
    {
      "source": "/astroyogi/(.*\\.(?:css|js|svg|png|jpg|jpeg|webp|ico|json))",
      "destination": "/astroyogi/$1"
    },
    {
      "source": "/astroyogi",
      "destination": "/astroyogi/index.html"
    },
    {
      "source": "/astroyogi/face-reading",
      "destination": "/astroyogi/face-reading/index.html"
    },
    {
      "source": "/astroyogi/palm-answers",
      "destination": "/astroyogi/palm-answers/index.html"
    },
    {
      "source": "/astroyogi/name-numerology",
      "destination": "/astroyogi/name-numerology/index.html"
    },
    {
      "source": "/astroyogi/partner-name",
      "destination": "/astroyogi/partner-name/index.html"
    },
    {
      "source": "/astroyogi/best-city",
      "destination": "/astroyogi/best-city/index.html"
    },
    {
      "source": "/astroyogi/mahakundli",
      "destination": "/astroyogi/mahakundli/index.html"
    },
    {
      "source": "/astroyogi/market-profile",
      "destination": "/astroyogi/market-profile/index.html"
    },
    {
      "source": "/astroyogi/about-us",
      "destination": "/astroyogi/about-us/index.html"
    },
    {
      "source": "/astroyogi/contact-us",
      "destination": "/astroyogi/contact-us/index.html"
    },
    {
      "source": "/astroyogi/terms-and-conditions",
      "destination": "/astroyogi/terms-and-conditions/index.html"
    },
    {
      "source": "/astroyogi/refund-policy",
      "destination": "/astroyogi/refund-policy/index.html"
    },
    {
      "source": "/astroyogi/shipping-policy",
      "destination": "/astroyogi/shipping-policy/index.html"
    },
    {
      "source": "/astroyogi/privacy-policy",
      "destination": "/astroyogi/privacy-policy/index.html"
